# Seed .config for the CMCC RAX3000-Z (ZX279128R) build.
#
# Lean first-bring-up seed: select the device and the essentials so a green
# baseline (boots, serial, wired net, WiFi, LuCI, flow-offload acceleration)
# comes back quickly.  Heavy extras (sing-box/smartdns/adblock/...) that the
# RAX1800-Z seed carries are intentionally left out until the base image is
# proven on hardware; add them once the board boots.
#
# Build with this seed instead of seed/e2631.config, e.g.:
#   ./apply.sh openwrt
#   cp seed/rax3000z.config openwrt/.config
#   ( cd openwrt && make defconfig && make -j$(nproc) )
# (apply.sh only lays down the overlay + hooks Makefile.e2631; it does not pick
#  the seed.  scripts/bootstrap.sh hardcodes the RAX1800-Z seed, so for RAX3000-Z
#  copy this file to .config by hand as above.)

CONFIG_TARGET_sanechips=y
CONFIG_TARGET_sanechips_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
# Build only the RAX3000-Z; deselect the other two boards in this overlay.
# CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_zte_zxhn-e2631 is not set
# CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_cmcc_rax1800-z is not set
CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_cmcc_rax3000-z=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# This SoC has no VFP; hard-float userspace would SIGILL on the device.
CONFIG_SOFT_FLOAT=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_COLLECT_KERNEL_DEBUG=y

# Console / debug helpers - cheap and wanted while the port is untested.
CONFIG_PACKAGE_minicom=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_libpcap=y

# WiFi: MT7916AN - mt7915e driver binds it, but it needs the mt7916 firmware
# set (kmod-mt7915e DEPENDS pulls mt7915-firmware; the mt7916 one is a separate
# select and must be named here or the image ships only mt7915_*.bin).
# CONFIG_PACKAGE_kmod-mt7915-firmware is not set
CONFIG_PACKAGE_kmod-mt7916-firmware=y
CONFIG_PACKAGE_wireless-regdb=y
# Full wpad (WPA3-SAE, 802.11r/k/v, 802.11s mesh) instead of wpad-basic.
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_kmod-hwmon-core=y

# "FFE acceleration" on OpenWrt = the nft flowtable + the driver's PPE path.
# kmod-nft-offload is the statement fw4 compiles "flow_offloading 1" into; the
# PPE hardware path already lives in zx279128s-ppe.c.
CONFIG_PACKAGE_kmod-nft-offload=y

# uboot-envtools: fw_printenv/fw_setenv to flip the boot slot if needed.
CONFIG_PACKAGE_uboot-envtools=y

# SoC temperature sensor (same die as RAX1800-Z; DTS node temp@94100034).
CONFIG_PACKAGE_kmod-rax1800z-thermal=y
CONFIG_PACKAGE_luci-app-rax1800z-temp=y
CONFIG_PACKAGE_luci-i18n-rax1800z-temp-zh-cn=y

# LuCI + Chinese base + web terminal + pppoe for the uplink.
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_libustream-mbedtls=y

# USB stays off: no usable USB on this board and probing reboots the SoC.
# CONFIG_PACKAGE_kmod-usb3 is not set
